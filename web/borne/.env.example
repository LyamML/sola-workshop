# Optionnel. Sans ces lignes, la borne lit BORNE_TOKEN dans server/.env
# (recommandé : une seule source de vérité pour le jeton).
#
# BORNE_TOKEN=même-valeur-que-server/.env
# BORD_URL=http://127.0.0.1:5175
#
# Modèle Ollama (préfixe VITE_ : visible dans le navigateur, ce n'est pas un secret).
# Défaut dans ia.ts : qwen3:14b (PC déploiement RTX 5080).
# Sur un laptop faible, décommentez et forcez un modèle plus léger :
# VITE_OLLAMA_MODEL=qwen3:8b
