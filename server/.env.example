# Copier en `.env` — ce fichier-ci est versionne, `.env` ne l'est jamais.

PORT=5175

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sola
DB_PASSWORD=change-moi
DB_NAME=sola

# Jeton porte par les bornes de cabine pour ecrire dans la base.
# En production chaque borne aurait le sien ; ici un seul suffit.
# Generer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BORNE_TOKEN=change-moi-aussi

# Origine autorisee a lire l'API (la console medicale).
CONSOLE_ORIGIN=http://localhost:5174

# Jour de vol courant : le vaisseau compte en jours depuis le depart.
JOUR_VOL=4128
