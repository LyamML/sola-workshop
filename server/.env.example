# Copier en `.env` — ce fichier-ci est versionne, `.env` ne l'est jamais.

PORT=5175

# Fichier SQLite du serveur de bord, relatif a la racine du depot.
# Il est dans .gitignore : la base ne part jamais sur GitHub.
DB_FILE=sola.db

# Jeton porte par les bornes de cabine pour ecrire dans la base.
# En production chaque borne aurait le sien ; ici un seul suffit.
# Generer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BORNE_TOKEN=change-moi-aussi

# Le jeton du backoffice a disparu : la console et le backoffice passent par
# des comptes (tables `medecins` et `admins`), un mot de passe hache en
# argon2id et une session dans un cookie httpOnly. Le premier compte se cree
# au terminal : npm run compte -- admin
#
# Mettre a 1 derriere HTTPS : le cookie de session porte alors l'attribut
# Secure et ne circule plus en clair. En developpement sur http://localhost,
# le laisser a 0 — sinon le navigateur refuse de le poser.
COOKIE_SECURE=0

# Origine autorisee a lire l'API (la console medicale).
CONSOLE_ORIGIN=http://localhost:5174
BACKOFFICE_ORIGIN=http://localhost:5176

# Jour de vol courant : le vaisseau compte en jours depuis le depart.
JOUR_VOL=4128
